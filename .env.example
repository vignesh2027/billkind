# Copy to .env. Without PayPal credentials the app runs against the built-in PayPal fake.
APP_BASE_URL=http://localhost:8800
PAYPAL_MODE=fake            # fake or sandbox (the hosted demo uses sandbox); fake refuses to start with credentials set
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=          # from the sandbox app's webhook settings
BILLER_SANDBOX_EMAIL=       # sandbox business account that receives biller payouts
GROQ_API_KEY=               # optional; without it the non-AI fallbacks run
SESSION_SECRET=              # generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Optional: AG Studio trial key for the Impact studio; without it Studio shows a watermark.
AG_STUDIO_LICENSE_KEY=
# Re-list fictional demo bills and renew the demo agent budget (sandbox and fake only); 0 turns it off.
DEMO_SELF_HEAL=1
# One-click sign-in to the shared demo Admin and Biller accounts. Leave at 0 for production; the hosted demo sets 1.
DEMO_ADMIN_LOGIN=0
# Optional, used by scripts and the opt-in sandbox contract test:
SANDBOX_SPONSOR_EMAIL=
SANDBOX_SPONSOR_PASSWORD=
